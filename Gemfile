gem "webrick"

# Ruby 3.4 no longer bundles these by default; Jekyll 3 still needs them.
# Only for the local preview: GitHub Pages builds with its own Ruby.
gem "erb"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
